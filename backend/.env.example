# ─────────────────────────────────────────────────────────────────────────────
#  CineAI Studio — backend settings
#  Copy this file to ".env" (same folder) and fill in what you use.
#  Only DATABASE_URL and TMDB_API_KEY are needed to start. Everything else is optional
#  and the matching feature simply says "not set up" until you add it.
#  NEVER commit your real .env — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# Database (SQLite file inside backend/prisma/). Leave as is.
DATABASE_URL="file:./dev.db"

# Port the backend listens on (the frontend expects 3000).
PORT=3000

# ── Required ───────────────────────────────────────────────────────────────
# TMDB (free): https://www.themoviedb.org/settings/api  → "API Key (v3 auth)"
TMDB_API_KEY=

# ── Ratings & data (free, optional) ───────────────────────────────────────
# OMDb (free, ~1000 lookups/day): https://www.omdbapi.com/apikey.aspx — Rotten Tomatoes / Metacritic
OMDB_API_KEY=
OMDB_BACKGROUND_DAILY_LIMIT=600
# MDBList (free): https://mdblist.com/preferences/ — Letterboxd / Trakt / RT audience
MDBLIST_API_KEY=
# IMDb's official daily ratings files (personal / non-commercial licence). Set to false to switch off.
IMDB_DATASETS=true

# ── AI (optional, click-only features) ─────────────────────────────────────
# Gemini key: https://aistudio.google.com/apikey   (AI posters need billing on the Google account)
GEMINI_API_KEY=
GEMINI_MODEL=
OTT_AI_MODEL=
AI_IMAGE_MODEL=
# true = fake AI responses for testing without a key
USE_MOCK_AI=false

# ── Instagram posting + analytics (optional) ───────────────────────────────
# Instagram Business/Creator account linked to a Facebook Page. See INSTALL.md → "Instagram".
IG_ACCESS_TOKEN=
IG_USER_ID=
# graph.facebook.com (Facebook-login token) or graph.instagram.com (Instagram-login token)
IG_GRAPH_HOST=graph.facebook.com
IG_GRAPH_VERSION=v23.0
# imgbb (free): https://api.imgbb.com/ — photos are hosted there for 10 minutes so Instagram can fetch them
IMGBB_API_KEY=

# ── Facebook Page posting (optional) ───────────────────────────────────────
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v23.0

# ── YouTube (optional) ─────────────────────────────────────────────────────
# Shorts upload: OAuth "Web application" client from Google Cloud Console,
# redirect URI http://localhost:3000/publish/youtube/callback
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# YouTube Data API key — "Watch Free site" channel scans
YT_API_KEY=

# ── Background jobs (defaults are fine) ────────────────────────────────────
OTT_AUTO_COLLECT=true
OTT_COLLECT_INTERVAL_HOURS=6
CINEMA_AUTO_COLLECT=true
CINEMA_COLLECT_INTERVAL_HOURS=6
WORLD_AUTO_ENRICH=true
WORLD_ENRICH_INTERVAL_MIN=30

# ── Advanced (leave empty unless you know you need it) ─────────────────────
FRONTEND_URL=http://localhost:3001
PUBLIC_BACKEND_URL=http://localhost:3000
JWT_SECRET=
ADMIN_PASSWORD=
