{
  "name": "quickflix-movie-poster",
  "version": "1.0.0",
  "description": "Root workspace to start frontend and backend together",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start:dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
